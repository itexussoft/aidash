{
  "name": "aidash",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Desktop dashboard showing quota usage across your Codex and Claude accounts",
  "repository": {
    "type": "git",
    "url": "git@github.com:itexussoft/aidash.git"
  },
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node app/test.mjs",
    "dist": "electron-builder",
    "site:dev": "wrangler dev --config worker/wrangler.toml",
    "site:deploy": "wrangler deploy --config worker/wrangler.toml",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "us.itex.aidash",
    "productName": "aidash",
    "files": [
      "app/**/*",
      "package.json",
      "CHANGELOG.md"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "sign": true
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "wrangler": "^4.118.0"
  }
}
